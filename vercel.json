{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "alias": [
    "igyrmannagementplatform.vercel.app",
    "igyr-platform.vercel.app"
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    }
  ]
}
